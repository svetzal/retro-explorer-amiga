# Where your own licensed Amiga products are on this computer.
# Copy this file to .env and fill in the folders. Git ignores .env.
# A variable set in the real environment overrides the value here.
# `~` at the start of a path means your home directory.
# The starter never downloads Kickstart ROMs. See
# guidance/starter/toolchain.md#firmware-and-launching.

# Cloanto Amiga Forever: the "Amiga Files" folder, which holds Shared/rom/.
# Supplies Kickstart 1.3 (a500) and Kickstart 3.1 (a1200), and rom.key.
AMIGA_FOREVER_DIR=

# Hyperion AmigaOS 3.2: the root of the CD-ROM or download, which holds ROM/.
# Supplies Kickstart 3.2 for the A1200 (a1200).
AMIGAOS32_DIR=
